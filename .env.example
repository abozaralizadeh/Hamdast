# Copy to .env and change what you need. Every value here is optional.
# There are no real keys or secrets in this file.

# Network
PORT=3000
HOST=127.0.0.1

# Product
GAME_NAME=MafiaNight
DEFAULT_LANGUAGE=fa
MIN_PLAYERS=6
MAX_PLAYERS=12
MIN_AGE=16

# Phase timers in milliseconds (the host can change these in the lobby)
INTRO_MS=20000
DAY_MS=180000
VOTE_MS=45000
NIGHT_MS=45000
SPEAK_MS=30000
MIN_PHASE_MS=10000
# true ends the night as soon as everyone has acted. false always runs the full
# timer so nobody can tell from the timing which roles are still alive.
NIGHT_EARLY_END=false

# Storage and logs
DATA_DIR=./data
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_KEEP=3
# Set false to keep logs out of the terminal and journal and write only the file.
LOG_STDOUT=true

# Retention
ROOM_RETENTION_HOURS=24
REPORT_RETENTION_DAYS=30
OPEN_REPORT_MAX_DAYS=60
# A ban is a hashed session token. It only works while that browser keeps its token, so it is dropped after this many days.
BAN_RETENTION_DAYS=90

# Voice: off, or fake (local stand-in, carries no audio). A real voice server
# would be a new provider in src/voice/, it is not built yet.
VOICE_PROVIDER=off

# Moderation: leave empty to turn the admin endpoints off. Set a long random
# value of your own to turn them on.
ADMIN_TOKEN=

# Behind a reverse proxy (Caddy), set true so the client address comes from
# X-Forwarded-For. Leave false when exposed directly.
TRUST_PROXY=false
