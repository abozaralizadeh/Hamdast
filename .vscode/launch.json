{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server/index.js",
      "runtimeArgs": ["--disable-warning=ExperimentalWarning"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Backend: tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--disable-warning=ExperimentalWarning", "--test", "test/**/*.test.js"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Frontend: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/public"
    }
  ],
  "compounds": [
    {
      "name": "Server + Browser",
      "configurations": ["Backend: server", "Frontend: Chrome"],
      "stopAll": true
    }
  ]
}
